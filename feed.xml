---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'it-IT' }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/feed.xml</id>
  <author><name>{{ site.author.name | xml_escape }}</name><email>{{ site.author.email | xml_escape }}</email></author>
  {% assign editions = site.newsletter | sort: 'date' | reverse %}
  {% for edition in editions limit: 20 %}
  <entry>
    <title>{{ edition.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ edition.url }}" rel="alternate" type="text/html" />
    <id>{{ site.url }}{{ edition.url }}</id>
    <published>{{ edition.date | date_to_xmlschema }}</published>
    <updated>{{ edition.date | date_to_xmlschema }}</updated>
    <content type="html">{{ edition.content | xml_escape }}</content>
    <summary type="html">{{ edition.excerpt | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
